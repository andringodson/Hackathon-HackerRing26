# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined at build time.

# Base URL of the FastAPI backend, e.g. http://localhost:8000
# Leave empty to run on the built-in demo data (no backend needed). The status
# strip shows "Demo data" instead of "Live" in that mode.
# Set it to /backend to go through this app's own proxy (src/app/backend), which
# forwards to API_URL. Deployments use that, so the API address is runtime config.
NEXT_PUBLIC_API_URL=

# Where the /backend proxy forwards to, read at request time (not inlined).
# Only used when NEXT_PUBLIC_API_URL=/backend. e.g. http://localhost:8000
API_URL=

# WebSocket endpoint for live events, e.g. ws://localhost:8000/ws/events (phase F4).
# Leave empty to fall back to polling.
NEXT_PUBLIC_WS_URL=

# MapLibre style URL. Default is the OpenFreeMap dark style (free, no API key).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
